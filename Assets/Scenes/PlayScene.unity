      m_Calls: []
  m_text: "\u2022 \uC790\uBC31 \uC720\uB3C4 \uC2DC\uC2A4\uD15C (System Overwhelm)\n\uD53C\uC758\uC790\uC758
    \uD575\uC2EC \uC800\uD56D \uC9C0\uC810\uC744 \uBD84\uC11D\uD558\uACE0 \uBB34\uB825\uD654\uD558\uC5EC,
    \uACB0\uC815\uC801\uC778 \uC9C4\uC220\uC744 \uD655\uBCF4\uD558\uC2ED\uC2DC\uC624.\n\n\u2022
    \uC124\uB4DD \uC2DC\uBBAC\uB808\uC774\uC158 \uB2EC\uC131 (100% Persuasion)\n\uC81C\uD55C\uB41C
    \uC2DC\uAC04(\uD134) \uB0B4\uC5D0 '\uC2EC\uB9AC\uC801 \uBB34\uC7A5 \uD574\uC81C'
    \uAC8C\uC774\uC9C0\uB97C 100%\uAE4C\uC9C0 \uC62C\uB824 \uC2DC\uBBAC\uB808\uC774\uC158\uC744
    \uC131\uACF5\uC801\uC73C\uB85C \uC644\uB8CC\uD558\uC2ED\uC2DC\uC624."
  m_isRightToLeft: 0
