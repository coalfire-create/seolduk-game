  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 \uB9DE\uCDA4\uD615 \uC811\uADFC (Adaptive Profiling)\n\uAC10\uC131,
    \uC790\uC874\uC2EC, \uB17C\uB9AC, \uC2E0\uB8B0 \uB4F1 \uB124 \uAC00\uC9C0 '\uC815\uC11C\uC801
    \uACB0\uD568' \uC911 \uB300\uC0C1\uC5D0\uAC8C \uAC00\uC7A5 \uC801\uD569\uD55C
    \uC57D\uC810\uC744 \uACF5\uB7B5\uD558\uC2ED\uC2DC\uC624.\n\n\u2022 \uC5B4\uC870
    \uBC0F \uB3D9\uC791 \uC11C\uC220 (Mannerisms)\n\uC9C8\uBB38 \uC785\uB825\uCC3D\uC5D0
    \uB300\uAD04\uD638 [ ]\uB97C \uC0AC\uC6A9\uD558\uC5EC \uD589\uB3D9\uC744 \uC11C\uC220\uD558\uC2ED\uC2DC\uC624.
    \uC608: [\uCC28\uBD84\uD558\uAC8C] \uB610\uB294 [\uB2E8\uD638\uD558\uAC8C]\n\n\u2022
    \uC804\uC220 \uD78C\uD2B8 \uD574\uAE08 (Tactical Unlocking)\n\uC124\uB4DD \uC2DC\uBBAC\uB808\uC774\uC158
    50% \uB2EC\uC131 \uC2DC, \uC2E4\uC2DC\uAC04 \uC2EC\uCE35 \uBD84\uC11D \uB370\uC774\uD130\uAC00
    \uD574\uAE08\uB429\uB2C8\uB2E4."
