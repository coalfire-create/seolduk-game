    & \uD589\uB3D9 \uBB18\uC0AC</b>\n\uAD04\uD638\uB85C \uD589\uB3D9\uC744 \uC785\uB825\uD558\uC138\uC694.\n\uC608:
    <color=#8A4B00>(\uCC28\uBD84\uD558\uAC8C)</color> \uB610\uB294 <color=#8A4B00>(\uCC45\uC0C1\uC744
    \uB450\uB4DC\uB9AC\uBA70)</color>\n\n<b>\u2022 \uACF5\uB7B5 \uD78C\uD2B8 \uD574\uAE08</b>\n\uC124\uB4DD\uB3C4
    50% \uC774\uC0C1 \uB2EC\uC131 \uC2DC \uC2E4\uC2DC\uAC04 \uD78C\uD2B8 \uB178\uCD9C."
