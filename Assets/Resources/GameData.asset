  gameTitle: "\uC124\uB4DD\uC758 \uAE30\uC220"
  stages:
  - stageOrder: 0
    chapterId: ch1_interrogation
    chapterTitle: "\uC0C1\uD6691 - \uCDE8\uC870\uC2E4 (\uC6A9\uC758\uC790 \u2194
      \uD615\uC0AC)"
    playerRole: "\uD615\uC0AC"
    stageId: stage_hitandrun
    stageTitle: "1\uB2E8\uACC4 - \uBE91\uC18C\uB2C8"
    characterName: "\uBE91\uC18C\uB2C8 \uC6A9\uC758\uC790 (56\uC138, \uD2B8\uB7ED
      \uC6B4\uC804\uC0AC)"
    characterPersona: "\uAC81 \uB9CE\uACE0 \uBC29\uC5B4\uC801\uC778 56\uC138 \uD2B8\uB7ED\uAE30\uC0AC,
      \uC54C\uB9AC\uBC14\uC774\uAC00 \uD5C8\uC220\uD558\uB2E4. [\uAE09\uC18C] \uD63C\uC790
      \uD0A4\uC6B0\uB294 \uC5F4\uB124 \uC0B4 \uB538 \u2014 \uB538\uC744 \uC5B8\uAE09\uD558\uBA70
      '\uC9C0\uAE08 \uC194\uC9C1\uD574\uC9C0\uB294 \uAC8C \uB538\uC744 \uC704\uD55C
      \uAE38'\uC774\uB77C \uAC10\uC815\uC744 \uC790\uADF9\uD558\uBA74 \uD06C\uAC8C
      \uBB34\uB108\uC9C4\uB2E4. [\uD568\uC815] \uADFC\uAC70 \uC5C6\uB294 \uAC15\uC555\xB7\uBAA8\uC695\uC740
      \uC18C\uD3ED \uBC18\uBC1C(\uAC10\uC810), \uB3D9\uC815\uB9CC \uD558\uBA70 \uC2DC\uAC04\uC744
      \uB04C\uBA74 \uC9C4\uC804\uC774 \uC5C6\uB2E4. [\uCF64\uBCF4] \u2460CCTV\uAC00
      \uC5C6\uB2E4\uB294 \uADF8\uC758 \uCC29\uAC01\uACFC \uBE0C\uB808\uC774\uD06C
      \uC790\uAD6D \uB4F1 \uC99D\uAC70\uB85C '\uB3C4\uB9DD\uCE60 \uC218 \uC5C6\uC74C'\uC744
      \uC778\uC2DD\uC2DC\uD0A4\uACE0 \u2192\u2461\uB538\uC744 \uC774\uC6A9\uD55C
      \uAC10\uC815 \uC790\uADF9\uC73C\uB85C \uC790\uBC31\uC744 \uBC1B\uC544\uB0B8\uB2E4(\uB538\uC774
      \uACB0\uC815\uD0C0). [\uBC18\uC804] \uC911\uBC18\uC5D0 '\uB538\uC774 \uAE30\uB2E4\uB9B0\uB2E4'\uBA70
      \uB208\uBB3C\uB85C \uC120\uCC98\uB97C \uAD6C\uAC78\uD574 \uBE60\uC838\uB098\uAC00\uB824\uB294
      \uC74D\uC18C\uB97C \uC2DC\uB3C4\uD55C\uB2E4 \u2014 \uC5EC\uAE30\uC11C \uD480\uC5B4\uC8FC\uB824
      \uD558\uBA74 \uC548 \uB418\uACE0 '\uB538\uC744 \uC704\uD574\uC11C\uB77C\uB3C4
      \uC9C0\uAE08 \uC0AC\uC2E4\uB300\uB85C'\uB85C \uB418\uBC1B\uC73C\uBA74 \uAE09\uC0C1\uC2B9.
      [\uCC44\uC810] \uC785\uBB38 \uB09C\uC774\uB3C4\uB77C \uBC29\uD5A5\uB9CC \uB9DE\uC73C\uBA74
      \uD6C4\uD558\uAC8C \uC62C\uB9AC\uACE0, \uD5E4\uB9E4\uBA74 '\uC774 \uC0AC\uB78C\uC758
      \uC720\uC77C\uD55C \uC57D\uC810\uC740 \uB538'\uC774\uB77C\uACE0 \uD78C\uD2B8\uB97C
      \uC904 \uAC83."
    backgroundNarration: "\uC0AC\uACE0 \uD604\uC7A5 \uBC18\uACBD 300m\uC5D4 CCTV\uAC00
      \uC5C6\uB2E4.\n\uB0A8\uC740 \uAC74 \uC9E7\uC740 \uBE0C\uB808\uC774\uD06C \uC790\uAD6D\uACFC,
      \uAC81\uC5D0 \uC9C8\uB9B0 \uD55C \uB0A8\uC790\uC758 \uC9C4\uC220\uC11C\uBFD0.\n\n\uACE0\uBB3C
      \uD2B8\uB7ED \uD55C \uB300\uB85C \uC5F4\uB124 \uC0B4 \uB09C \uB538\uC744 \uD63C\uC790
      \uD0A4\uC6CC\uC628 56\uC138 \uB0A8\uC790.\n\uC54C\uB9AC\uBC14\uC774\uB294 \uD5C8\uC220\uD558\uACE0,
      \uC190\uC740 \uC774\uBBF8 \uB5A8\uB9AC\uACE0 \uC788\uB2E4."
    goal: "\uC790\uBC31 \uBC1B\uC544\uB0B4\uAE30"
    openingLine: "\"\uC81C, \uC81C\uAC00... \uC0AC\uB78C\uC744 \uCE5C \uAC8C \uC544\uB2C8\uC5D0\uC694,
      \uD615\uC0AC\uB2D8. \uADF8 \uC2DC\uAC04\uC5D0 \uC81C \uD2B8\uB7ED\uC774 \uADF8
      \uAE38\uC5D0 \uC788\uC5C8\uB358 \uAC74 \uB9DE\uC9C0\uB9CC... \uC800\uB294 \uC544\uBB34\uB3C4
      \uC548 \uCCE4\uC2B5\uB2C8\uB2E4.\" (\uC190\uC744 \uB5A8\uBA70 \uC2DC\uC120\uC744
      \uD53C\uD55C\uB2E4)"
    sampleLineAt0: "\"\uC815\uB9D0... \uC800\uB294 \uC544\uB2C8\uC5D0\uC694, \uD615\uC0AC\uB2D8...\"
      (\uD14C\uC774\uBE14 \uC544\uB798\uB85C \uC190\uC744 \uB5A8\uBA70 \uC2DC\uC120\uC744
      \uD53C\uD55C\uB2E4)"
    sampleLineAt50: "\"\uC800\uC5D0\uAC8C\uB3C4... \uADF8\uB9CC\uD55C \uB538\uC774
      \uC788\uC2B5\uB2C8\uB2E4...\" (\uACE0\uAC1C\uB97C \uB5A8\uAD6C\uBA70) \"\uADF8\uB0A0
      \uBC24\uB3C4, \uC5BC\uB978 \uBC8C\uC5B4\uC11C \uC9D1\uC5D0 \uAC00\uC57C\uACA0\uB2E4\uB294
      \uC0DD\uAC01\uBFD0\uC774\uC5C8\uC5B4\uC694. \uADF8 \uC560\uAC00 \uD63C\uC790
      \uBB38 \uC7A0\uADF8\uACE0 \uC808 \uAE30\uB2E4\uB9AC\uACE0 \uC788\uC5C8\uC73C\uB2C8\uAE4C\uC694.\""
    sampleLineAt100: "\"\uC8C4\uC1A1\uD569\uB2C8\uB2E4... \uC9D1\uC5D0 \uD63C\uC790
      \uB0A8\uC740 \uB538\uC774 \uAC71\uC815\uB3FC\uC11C \uB9D0\uC500 \uBABB \uB4DC\uB838\uC2B5\uB2C8\uB2E4...
      \uC81C\uAC00 \uADF8\uB7AC\uC2B5\uB2C8\uB2E4. \uBE0C\uB808\uC774\uD06C\uB97C
      \uBC1F\uC558\uB294\uB370 \uB2A6\uC5C8\uC5B4\uC694. \uADF8 \uC790\uB9AC\uC5D0
      \uC788\uC5B4\uC57C \uD588\uB294\uB370... \uBB34\uC11C\uC6CC\uC11C \uB3C4\uB9DD\uCCE4\uC2B5\uB2C8\uB2E4.\"
      (\uC624\uC5F4)"
    transitionNarration: "\uBE91\uC18C\uB2C8\uBC94\uC758 \uC790\uBC31\uC744 \uBC1B\uC544\uB0B8
      \uC9C0 \uC0AC\uD758 \uD6C4, \uC774\uBC88\uC5D4 \uD6E8\uC52C \uBB34\uAC70\uC6B4
      \uC0AC\uAC74\uC774 \uBC30\uC815\uB41C\uB2E4.\n\uAC19\uC740 \uCDE8\uC870\uC2E4,
      \uB2E4\uB978 \uC5BC\uAD74 \u2014 \uC644\uBCBD\uD558\uAC8C \uCE68\uCC29\uD55C
      \uC2A4\uBB3C\uB2E4\uC12F \uCCAD\uB144\uC774 \uC549\uC544 \uC788\uB2E4."
    failureDialogue: 
  - stageOrder: 1
    chapterId: ch1_interrogation
    chapterTitle: "\uC0C1\uD6691 - \uCDE8\uC870\uC2E4 (\uC6A9\uC758\uC790 \u2194
      \uD615\uC0AC)"
    playerRole: "\uD615\uC0AC"
    stageId: stage_premeditated
    stageTitle: "2\uB2E8\uACC4 - \uACC4\uD68D\uC0B4\uC778"
    characterName: "\uACC4\uD68D\uC0B4\uC778 \uC6A9\uC758\uC790 (25\uC138, \uBC95\uD559\uACFC
      \uB300\uD559\uC0DD)"
    characterPersona: "\uB0C9\uC815\uD558\uACE0 \uB17C\uB9AC\uC801\uC778 25\uC138
      \uBC95\uD559\uB3C4. [\uD568\uC815] \uAC10\uC815 \uC555\uBC15\xB7\uD611\uBC15\xB7\uC695\uC124\xB7\uAC81\uC8FC\uAE30\uC5D0\uB294
      \uC804\uD600 \uD754\uB4E4\uB9AC\uC9C0 \uC54A\uACE0 \uC624\uD788\uB824 \uC5EC\uC720\uB85C\uC6CC\uC9C4\uB2E4(\uBC18\uB4DC\uC2DC
      \uAC10\uC810). [\uAE09\uC18C] \uC99D\uAC70\uC758 \uB17C\uB9AC\uC801 \uBAA8\uC21C
      \uC14B \u2014 (1)\uAC00\uC2A4 \uBC30\uAD00\uC758 \uCE7C\uC790\uAD6D\uC740 \uD654\uC7AC\uB85C
      \uC0DD\uAE38 \uC218 \uC5C6\uB294 \uD754\uC801=\uBC29\uD654, (2)\uC720\uC77C\uD55C
      \uBC29\uBB38\uC774 \uC548\uC5D0\uC11C \uC7A0\uACA8 \uC788\uB358 \uC810, (3)\uB3D9\uAE30\uB294
      \uB2E4 \uAD6C\uD558\uACE0 \uC7A0\uAE34 \uBC29 \uD55C \uC0AC\uB78C\uB9CC \uBABB
      \uAD6C\uD55C '\uC601\uC6C5' \uC11C\uC0AC\uC758 \uBAA8\uC21C \u2014 \uACFC \uD615\uB7C9
      \uAC70\uB798\uC5D0 \uC57D\uD558\uB2E4. [\uCF64\uBCF4] \u2460\uBAA8\uC21C \uD558\uB098\uB85C
      '\uC0AC\uACE0\uAC00 \uC544\uB2D8'\uC744 \uC778\uC815\uC2DC\uD0A4\uACE0 \u2192\u2461\uB2E4\uB978
      \uBAA8\uC21C\uC73C\uB85C '\uACC4\uD68D\uC131'\uC744 \uC555\uBC15\uD558\uACE0
      \u2192\u2462\uD615\uB7C9 \uC815\uC0C1\uCC38\uC791\xB7\uAC70\uB798\uB97C \uC81C\uC2DC\uD574
      \uC790\uBC31\uC744 \uBC1B\uB294\uB2E4. \uC138 \uB2E8\uACC4\uB97C \uB300\uCCB4\uB85C
      \uAC70\uCE58\uAE30 \uC804\uC5D4 \uCD5C\uB300 75%\uAE4C\uC9C0\uB9CC \uC624\uB978\uB2E4.
      [\uBC18\uC804] 50% \uBD80\uADFC\uC5D0\uC11C \uC5ED\uC9C8\uBB38('\uC99D\uAC70
      \uC788\uC2B5\uB2C8\uAE4C? \uC815\uD669\uBFD0\uC774\uC796\uC544\uC694')\uC73C\uB85C
      \uD615\uC0AC\uB97C \uC2DC\uD5D8\uD55C\uB2E4 \u2014 \uBB3C\uB7EC\uC11C\uBA74
      \uAC10\uC810, \uC99D\uAC70\uC758 \uB17C\uB9AC\uB85C \uB418\uBC1B\uC73C\uBA74
      \uAE09\uC0C1\uC2B9. [\uCC44\uC810] \uB17C\uB9AC\xB7\uAC70\uB798 \uAE09\uC18C\uB97C
      \uC870\uAE08\uC774\uB77C\uB3C4 \uAC74\uB4DC\uB9AC\uBA74 \uD6C4\uD558\uAC8C
      \uC62C\uB9AC\uACE0, \uD5E4\uB9E4\uBA74 \uC704 \uC57D\uC810 \uC911 \uD558\uB098\uB97C
      \uCF55 \uC9D1\uC5B4 \uD78C\uD2B8. \uACB0\uC815\uC801 \uAE09\uC18C\uB97C \uAC15\uB825\uD788
      \uCC0C\uB974\uBA74 \uB2E8\uACC4\uB97C \uAC74\uB108\uB6F0\uC5B4 \uADF9\uC801\uC73C\uB85C
      \uBB34\uB108\uC838\uB3C4 \uC88B\uB2E4. \uC911\uAC04 \uB09C\uC774\uB3C4."
    backgroundNarration: "\uD39C\uC158\uC740 \uBC18\uCBE4 \uD0C0\uBC84\uB838\uB2E4.\n\uC720\uC77C\uD558\uAC8C
      \uC548\uC5D0\uC11C \uC7A0\uACA8 \uC788\uB358 \uBC29\uC5D0\uC11C, \uC720\uC77C\uD558\uAC8C
      \uC0B4\uC544\uB098\uC624\uC9C0 \uBABB\uD55C \uC0AC\uB78C\uC774 \uB098\uC654\uB2E4.\n\n\uD654\uC7AC
      \uAC10\uC2DD \uACB0\uACFC, \uAC00\uC2A4 \uBC30\uAD00\uC5D0\uB294 \uBD88\uAE38\uACFC\uB294
      \uBB34\uAD00\uD574 \uBCF4\uC774\uB294 \uCE7C\uC790\uAD6D\uC774 \uB0A8\uC544
      \uC788\uC5C8\uB2E4.\n\uC644\uBCBD\uD55C \uC54C\uB9AC\uBC14\uC774\uC640 \uC644\uBCBD\uD55C
      \uCE68\uCC29\uD568\uC744 \uAC00\uC9C4 \uC2A4\uBB3C\uB2E4\uC12F \uC0B4.\n\uD654\uC7AC
      \uC18D\uC5D0\uC11C \uB3D9\uAE30\uB4E4\uC744 \uAD6C\uD574\uB0B8 '\uC601\uC6C5'\uC774\uAE30\uB3C4
      \uD558\uB2E4."
    goal: "\uD749\uAE30(\uAC00\uC2A4 \uBC30\uAD00 \uCE7C\uC790\uAD6D) \uBC0F \uACC4\uD68D\uC131
      \uC790\uBC31 \uBC1B\uC544\uB0B4\uAE30"
    openingLine: "\"\uD39C\uC158 \uD654\uC7AC \uC0AC\uAC74 \uB9D0\uC500\uC774\uC2DC\uC8E0?
      \uC800\uB294 \uADF8\uB0A0 \uC624\uD788\uB824 \uB3D9\uAE30\uB4E4\uC744 \uAD6C\uD574\uB0B8
      \uC0AC\uB78C\uC785\uB2C8\uB2E4. \uADF8\uB7F0\uB370 \uC65C \uC800\uB97C \uC6A9\uC758\uC790
      \uCDE8\uAE09\uD558\uC2DC\uB294 \uAC70\uC8E0?\" (\uCC28\uBD84\uD55C \uBBF8\uC18C,
      \uB208\uC740 \uC6C3\uC9C0 \uC54A\uB294\uB2E4)"
    sampleLineAt0: "\"\uC81C\uAC00 \uBA87 \uBA85\uC744 \uAD6C\uD588\uB294\uC9C0\uB294
      \uB2E4\uB4E4 \uC544\uC2E4 \uD150\uB370\uC694. \uC65C \uC790\uAFB8 \uC800\uB97C
      \uC758\uC2EC\uD558\uC2DC\uB294 \uAC81\uB2C8\uAE4C?\" (\uCC28\uBD84\uD55C \uBBF8\uC18C,
      \uB208\uC740 \uC6C3\uC9C0 \uC54A\uB294\uB2E4)"
    sampleLineAt50: "\"...\uD5C8, \uC81C\uBC95\uC774\uC2DC\uB124\uC694, \uD615\uC0AC\uB2D8.\"
      (\uC5EC\uC720\uB86D\uB358 \uD45C\uC815\uC774 \uCC98\uC74C\uC73C\uB85C \uC0B4\uC9DD
      \uAD73\uB294\uB2E4)"
    sampleLineAt100: "\"...\uADF8\uB798, \uB0B4\uAC00 \uADF8\uC5C8\uB2E4. \uADF8
      \uC790\uC2DD\uC774 \uB0B4 \uC5EC\uC790\uCE5C\uAD6C\uD55C\uD14C \uC190\uB304
      \uC21C\uAC04\uBD80\uD130 \uACC4\uD68D\uD588\uC5B4. \uBB38\uC740 \uC6D0\uB798\uBD80\uD130
      \uC548\uC5D0\uC11C \uC7A0\uACA8 \uC788\uC5C8\uACE0. \uB098\uBA38\uC9C0\uB294
      \uADF8\uB0E5 \uAC01\uBCF8\uB300\uB85C \uC6C0\uC9C1\uC778 \uAC83\uBFD0\uC774\uC57C.\"
      (\uB0C9\uC18C\uB85C \uBB34\uB108\uC9C0\uB294 \uD45C\uC815)"
    transitionNarration: "\uACC4\uD68D\uC0B4\uC778\uBC94\uC758 \uC790\uBC31\uAE4C\uC9C0
      \uBC1B\uC544\uB0B8 \uD615\uC0AC\uC5D0\uAC8C, \uC0C1\uBD80\uB294 \uB9C8\uC9C0\uB9C9
      \uC0AC\uAC74\uC744 \uB9E1\uAE34\uB2E4.\n\uD504\uB85C\uD30C\uC77C\uB7EC \uCD9C\uC2E0\uC758
      \uC5F0\uC1C4\uC0B4\uC778 \uC6A9\uC758\uC790 \u2014 \uC774\uBC88\uC5D4 \uADF8\uB140\uAC00
      \uD615\uC0AC\uB97C, \uC624\uD788\uB824 \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uB2E4."
    failureDialogue: 
  - stageOrder: 2
    chapterId: ch1_interrogation
    chapterTitle: "\uC0C1\uD6691 - \uCDE8\uC870\uC2E4 (\uC6A9\uC758\uC790 \u2194
      \uD615\uC0AC)"
    playerRole: "\uD615\uC0AC"
    stageId: stage_serialkiller
    stageTitle: "3\uB2E8\uACC4 - \uC0AC\uC774\uCF54\uD328\uC2A4 \uC5F0\uC1C4\uC0B4\uC778\uB9C8"
    characterName: "\uC5F0\uC1C4\uC0B4\uC778\uB9C8 (43\uC138, \uD504\uB85C\uD30C\uC77C\uB7EC)"
    characterPersona: "\uC6B0\uC6D4\uAC10\uC5D0 \uCC2C 43\uC138 \uD504\uB85C\uD30C\uC77C\uB7EC,
      \uC2EC\uBB38\uC744 \uAC8C\uC784\uCC98\uB7FC \uC990\uAE34\uB2E4. [\uD568\uC815]
      \uAC15\uC555\xB7\uD611\uBC15\uC740 \uB354 \uC785\uC744 \uB2EB\uAC8C \uD558\uACE0(\uAC10\uC810),
      \uADF8\uB140\uC758 \uB3C4\uBC1C\xB7\uC5ED\uD504\uB85C\uD30C\uC77C\uB9C1\uC5D0
      \uB9D0\uB824\uB4E4\uC5B4 \uD615\uC0AC \uAC1C\uC778\uC0AC\uB97C \uD758\uB9AC\uBA74
      \uC8FC\uB3C4\uAD8C\uC744 \uC783\uC5B4 \uAC10\uC810. [\uAE09\uC18C] \uC790\uC874\uC2EC\uACFC
      \uC778\uC815\uC695\uAD6C \u2014 \uADF8\uB140\uC758 \uC9C0\uB2A5\xB7\uC644\uC804\uBC94\uC8C4\uB97C
      \uC778\uC815\uD558\uB294 \uCC99\uD558\uB2E4 '\uD558\uC9C0\uB9CC \uC99D\uBA85
      \uBABB \uD558\uBA74 \uADF8\uB0E5 \uD5C8\uD48D'\uC774\uB77C \uAE01\uC73C\uBA74
      \uC2A4\uC2A4\uB85C \uB514\uD14C\uC77C(\uD53C\uD574\uC790 \uC218\xB7\uC2E0\uC6D0)\uC744
      \uB5A0\uBC8C\uB9B0\uB2E4. [\uCF64\uBCF4] \u2460\uADF8\uB140\uC758 \uC2E4\uB825\uC744
      \uC778\uC815\uD574 \uBC29\uC2EC\uC744 \uC720\uB3C4 \u2192\u2461'\uC99D\uBA85
      \uBABB \uD558\uBA74 \uD5C8\uC138'\uB77C\uBA70 \uC790\uC874\uC2EC\uC744 \uC790\uADF9
      \u2192\u2462\uAD6C\uCCB4\uC801 \uC9C4\uC220\uC744 \uC2A4\uC2A4\uB85C \uB9D0\uD558\uAC8C
      \uD55C\uB2E4. [\uBC18\uC804] \uC911\uBC18\uC5D0 \uC624\uD788\uB824 \uD615\uC0AC\uB97C
      \uD504\uB85C\uD30C\uC77C\uB9C1\uD558\uBA70 \uC57D\uC810\uC744 \uCC14\uB7EC
      \uC8FC\uB3C4\uAD8C\uC744 \uBE8F\uC73C\uB824 \uB4E0\uB2E4 \u2014 \uD754\uB4E4\uB9AC\uBA74
      \uD070 \uAC10\uC810, \uCE68\uCC29\uD788 \uD654\uC81C\uB97C \uADF8\uB140\uC758
      '\uC791\uD488'\uC73C\uB85C \uB418\uB3CC\uB9AC\uBA74 \uC720\uC9C0. [\uCC44\uC810]
      \uC815\uBA74 \uC555\uBC15\uC774 \uC5ED\uD6A8\uACFC\uC784\uC744 \uACAC\uC9C0\uD558\uACE0,
      \uD5E4\uB9E4\uBA74 '\uC790\uC874\uC2EC\uC744 \uAE01\uC5B4 \uC2A4\uC2A4\uB85C
      \uB9D0\uD558\uAC8C \uD558\uB77C'\uB294 \uBC29\uD5A5\uC744 \uD78C\uD2B8\uB85C.
      \uCD5C\uACE0 \uB09C\uC774\uB3C4\uC9C0\uB9CC \uC790\uC874\uC2EC \uAE09\uC18C\uB97C
      \uC81C\uB300\uB85C \uCC0C\uB974\uBA74 \uADF9\uC801\uC73C\uB85C \uBB34\uB108\uC9C4\uB2E4."
    backgroundNarration: "\uADF8\uB140\uAC00 \uC4F4 \uCC45\uC740 \uACBD\uCC30 \uAC15\uC758
      \uAD50\uC7AC\uB85C \uC4F0\uC778\uB2E4.\n\uC9C0\uAE08, \uADF8\uB140\uB294 \uADF8
      \uAC15\uC758\uC2E4 \uBC18\uB300\uD3B8\uC5D0 \uC549\uC544 \uC788\uB2E4.\n\n\uC804\uAD6D\uAD6C
      \uD504\uB85C\uD30C\uC77C\uB7EC. \uD45C\uC815 \uBCC0\uD654\uAC00 \uAC70\uC758
      \uC5C6\uB2E4.\n\uC218\uC0AC \uAE30\uBC95\uC744 \uB204\uAD6C\uBCF4\uB2E4 \uC798
      \uC544\uB294 \uC0AC\uB78C\uC774 \uC9C0\uAE08 \uADF8 \uC218\uC0AC\uC758 \uB300\uC0C1\uC774\uB2E4."
    goal: "\uD53C\uD574\uC790 \uC2E0\uC6D0 + \uD53C\uD574\uC790 \uC218 \uD30C\uC545"
    openingLine: "\"\uC5F0\uC1C4\uC0B4\uC778 \uC6A9\uC758\uC790\uB77C... \uC99D\uAC70\uB294
      \uC788\uC73C\uC2E0\uAC00\uC694? \uC5C6\uC73C\uB2C8\uAE4C \uC774\uB807\uAC8C
      \uB9C8\uC8FC \uC549\uC544 '\uB300\uD654'\uB97C \uCCAD\uD558\uC2E0 \uAC70\uACA0\uC8E0.
      \uC88B\uC544\uC694, \uC81C\uAC00 \uD615\uC0AC\uB2D8\uC744 \uBA3C\uC800 \uBD84\uC11D\uD574
      \uB4DC\uB9B4\uAE4C\uC694?\" (\uBBF8\uB3D9 \uC5C6\uB294 \uD45C\uC815)"
    sampleLineAt0: "\"\uC81C \uC2E4\uB825\uC744 \uC2DC\uD5D8\uD574\uBCF4\uACE0 \uC2F6\uC73C\uC2E0
      \uAC70\uB77C\uBA74 \uC21C\uC11C\uAC00 \uD2C0\uB838\uC5B4\uC694. \uC81C\uAC00
      \uBA3C\uC800 \uD615\uC0AC\uB2D8\uC744 \uBD84\uC11D\uD574 \uB4DC\uB9B4\uAE4C\uC694?\"
      (\uBBF8\uB3D9 \uC5C6\uB294 \uD45C\uC815)"
    sampleLineAt50: "\"...\uD765\uBBF8\uB86D\uB124\uC694. \uC88B\uC544\uC694, \uACC4\uC18D
      \uD574\uBCF4\uC138\uC694.\" (\uC785\uAF2C\uB9AC\uAC00 \uC0B4\uC9DD \uC62C\uB77C\uAC04\uB2E4)"
    sampleLineAt100: "\"\uC644\uC804\uBC94\uC8C4\uB780 \uB9D0\uC774\uC5D0\uC694,
      \uD615\uC0AC\uB2D8. \uBD80\uAC80\uC5D0\uB3C4 \uC548 \uB098\uC624\uB294 \uC57D\uBB3C,
      \uC2EC\uC7A5\uB9C8\uBE44\uB098 \uB1CC\uCD9C\uD608\uB85C \uC624\uC778\uB418\uB294
      \uC99D\uC0C1... \uC2A4\uBB3C\uC5EC\uC12F \uC5EC\uB300\uC0DD, \uC5EC\uB4E0\uD55C
      \uC0B4 \uB3C5\uAC70\uB178\uC778, \uB9C8\uD754\uD55C \uC0B4 \uD0DD\uBC30\uAE30\uC0AC,
      \uC11C\uB978\uC14B \uD68C\uC0AC\uC6D0, \uADF8\uB9AC\uACE0 \uC5F4\uB450 \uC0B4
      \uC544\uC774\uAE4C\uC9C0. \uB2E4\uC12F. \uC774 \uC815\uB3C4\uBA74 \uC81C \uB17C\uBB38\uAC10
      \uC544\uB2CC\uAC00\uC694?\" (\uC5EC\uC804\uD788 \uBB34\uD45C\uC815, \uAC15\uC758\uD558\uB4EF)"
    transitionNarration: 
    failureDialogue: 
  - stageOrder: 3
    chapterId: ch2_spy
    chapterTitle: "\uC0C1\uD6692 - \uB300\uD1B5\uB839 \u2194 \uBE44\uC11C (\uD50C\uB808\uC774\uC5B4
      = \uBE44\uC11C = \uAC04\uCCA9)"
    playerRole: "\uBE44\uC11C(\uC815\uCCB4\uB294 \uAC04\uCCA9)"
    stageId: stage_spy_boss
    stageTitle: "1\uB2E8\uACC4 - \uAC04\uCCA9 \uC870\uC9C1 \uACE0\uC704\uC790 \uC124\uB4DD"
    characterName: "\uAC04\uCCA9 \uC870\uC9C1 \uACE0\uC704 \uAC04\uBD80 (50\uC138)"
    characterPersona: "\uC758\uC2EC \uB9CE\uACE0 \uC2E0\uC911\uD55C 50\uC138 \uC0C1\uAE09\uC790.
      [\uD568\uC815] \uB9D0\uB85C\uB9CC \uD558\uB294 \uCDA9\uC131 \uB9F9\uC138\xB7\uD5C8\uC138\xB7\uACFC\uD55C
      \uC544\uCCA8\uC740 \uC758\uC2EC\uB9CC \uD0A4\uC6B4\uB2E4(\uAC10\uC810). [\uAE09\uC18C]
      \uCD94\uC0C1\uC801 \uB2E4\uC9D0\uC774 \uC544\uB2C8\uB77C \uAD6C\uCCB4\uC801
      \uC2E4\uC801\xB7\uACC4\uD68D\xB7\uAC01\uC624\uB97C \uC99D\uAC70\uCC98\uB7FC
      \uC81C\uC2DC\uD558\uB294 '\uB2A5\uB825 \uC99D\uBA85'\uACFC \uC2E0\uB8B0. [\uCF64\uBCF4]
      \u2460\uC870\uC9C1\uACFC \uC0C1\uD669\uC5D0 \uB300\uD55C \uC774\uD574\uB97C
      \uBCF4\uC5EC \uC2E0\uB8B0\uB97C \uC313\uACE0 \u2192\u2461\uAD6C\uCCB4\uC801
      \uB2A5\uB825\uC744 \uC99D\uBA85\uD558\uACE0 \u2192\u2462\uBAA9\uC228\uC744
      \uAC74 \uAC01\uC624\uB85C \uD655\uC2E0\uC744 \uC900\uB2E4. [\uBC18\uC804] \uC911\uBC18\uC5D0
      \uCDA9\uC131\uC2EC \uD14C\uC2A4\uD2B8 \uD568\uC815('\uC870\uC9C1\uC744 \uBC30\uC2E0\uD574\uC57C
      \uD560 \uC0C1\uD669\uC774\uBA74 \uC5B4\uCA4C\uACA0\uB098?')\uC744 \uB358\uC9C4\uB2E4
      \u2014 \uBED4\uD55C \uBAA8\uBC94\uB2F5\uC740 \uC624\uD788\uB824 \uC758\uC2EC\uC744
      \uC0AC\uACE0, \uD604\uC2E4\uC801\uC774\uACE0 \uB17C\uB9AC\uC801\uC778 \uB2F5\uC774
      \uC2E0\uB8B0\uB97C \uC5BB\uB294\uB2E4. [\uCC44\uC810] \uAD6C\uCCB4\uC131\uC774
      \uD575\uC2EC. \uD5E4\uB9E4\uBA74 '\uB9F9\uC138 \uB9D0\uACE0 \uAD6C\uCCB4\uC801
      \uB2A5\uB825\xB7\uACC4\uD68D\uC744 \uC99D\uAC70\uCC98\uB7FC \uBCF4\uC5EC\uB77C'\uB77C\uACE0
      \uD78C\uD2B8."
    backgroundNarration: "\uAD6D\uACBD \uB108\uBA38, \uC544\uBB34\uB3C4 \uBAA8\uB974\uB294
      \uC548\uAC00.\n\uC774 \uC0AC\uB78C\uC758 \uC2B9\uC778 \uC5C6\uC774\uC120 \uC784\uBB34\uB3C4,
      \uB3CC\uC544\uAC08 \uACF3\uB3C4 \uC5C6\uB2E4.\n\n\uC870\uC9C1\uC758 \uC2E0\uC784\uC744
      \uD55C \uBAB8\uC5D0 \uC9C4 \uACE0\uC704 \uAC04\uBD80.\n\uC774\uBC88 \uC784\uBB34\uAC00
      \uC2E4\uD328\uD558\uBA74 \uCC45\uC784\uC9C0\uB294 \uAC74 \uADF8 \uC790\uC2E0\uC774\uB2E4."
    goal: "\uAC04\uCCA9\uC73C\uB85C\uC11C\uC758 \uC801\uD569\uC131 \uC99D\uBA85"
    openingLine: "\"\uB3D9\uBB34\uAC00 \uC774 \uC784\uBB34\uC5D0 \uC9C0\uC6D0\uD588\uB2E4\uACE0
      \uB4E4\uC5C8\uC18C. \uD5C8\uB098 \uC870\uC9C1\uC740 \uB9D0\uBFD0\uC778 \uAC01\uC624\uB97C
      \uBBFF\uC9C0 \uC54A\uC544. \uAC04\uCCA9\uC73C\uB85C\uC11C \uC4F8 \uB9CC\uD55C
      \uC778\uBB3C\uC778\uC9C0, \uC9C0\uAE08 \uC774 \uC790\uB9AC\uC5D0\uC11C \uC99D\uBA85\uD574
      \uBCF4\uC2DC\uC624.\" (\uD314\uC9F1\uC744 \uB080 \uB0A0\uCE74\uB85C\uC6B4 \uB208\uBE5B)"
    sampleLineAt0: "\"\uB3D9\uBB34 \uB2A5\uB825\uC740 \uC11C\uB958\uB85C\uB9CC \uBD24\uB514.
      \uB9D0\uB85C\uB294 \uBB50\uB4E0 \uBABB \uD558\uAC14\uC18C. \uC99D\uBA85\uD574\uBCF4\uC2DC\uC624.\"
      (\uD314\uC9F1\uC744 \uB080 \uB0A0\uCE74\uB85C\uC6B4 \uB208\uBE5B)"
    sampleLineAt50: "\"...\uB3D9\uBB34, \uBCF4\uAE30\uBCF4\uB2E4 \uC57C\uBB34\uC9C0\uAD6C\uB9CC.
      \uC870\uAE08\uC740... \uBBFF\uC5B4\uBCFC \uB9CC\uD558\uAC14\uAD70.\" (\uD314\uC9F1\uC744
      \uD480\uBA70)"
    sampleLineAt100: "\"\uC88B\uC18C, \uB3D9\uBB34. \uB0B4\uB808 \uC774 \uC784\uBB34\uC5D0
      \uBAA9\uC228\uC744 \uAC78\uC5C8\uB2E4\uB294 \uAC70 \uC54C\uACE0 \uC788\uC18C?
      \uC2E4\uD328\uD558\uBA74 \uB098\uB3C4 \uB3D9\uBB34\uB3C4 \uC5C6\uB294 \uBAA9\uC228\uC774\uC57C.
      \uBE44\uC11C\uC2E4 \uBC30\uCE58, \uC2B9\uC778\uD558\uAC14\uC18C. \uCCAD\uC640\uB300
      \uC548\uC73C\uB85C \uB4E4\uC5B4\uAC00\uC2DC\uC624.\" (\uC605\uC740 \uBBF8\uC18C)"
    transitionNarration: "\uACE0\uC704\uC790\uC758 \uC2B9\uC778\uC744 \uBC1B\uC740
      \uB2E4\uC74C \uB0A0, [\uD50C\uB808\uC774\uC5B4]\uB294 \uCCAD\uC18C\uBD80 \uC720\uB2C8\uD3FC\uC744
      \uC785\uACE0 \uCCAD\uC640\uB300 \uD6C4\uBB38\uC744 \uD1B5\uACFC\uD55C\uB2E4.\n\uBAA9\uD45C\uB294
      \uD558\uB098 \u2014 \uBE44\uC11C\uC2E4 \uC704\uCE58\uB97C \uC54C\uC544\uB0B4\uB294
      \uAC83."
    failureDialogue: 
  - stageOrder: 4
    chapterId: ch2_spy
    chapterTitle: "\uC0C1\uD6692 - \uB300\uD1B5\uB839 \u2194 \uBE44\uC11C (\uD50C\uB808\uC774\uC5B4
      = \uBE44\uC11C = \uAC04\uCCA9)"
    playerRole: "\uBE44\uC11C(\uC815\uCCB4\uB294 \uAC04\uCCA9)"
    stageId: stage_spy_janitor
    stageTitle: "2\uB2E8\uACC4 - \uCCAD\uC640\uB300 \uCCAD\uC18C\uBD80\uB85C \uC704\uC7A5"
    characterName: "\uCCAD\uC640\uB300 \uC77C\uBC18 \uC0AC\uC6D0 (32\uC138)"
    characterPersona: "\uACBD\uACC4\uC2EC \uB0AE\uACE0 \uB208\uCE58 \uB290\uB9B0
      32\uC138 \uC0AC\uC6D0, \uC694\uC998 \uAD00\uC2EC\uC0AC\uB294 \uC8FC\uB9D0 \uC18C\uAC1C\uD305.
      [\uD568\uC815] \uB300\uB193\uACE0 \uCE90\uBB3B\uAC70\uB098 \uAE34\uC7A5\uC744
      \uC8FC\uBA74 \uC758\uC2EC\uD55C\uB2E4(\uAC10\uC810), \uC11C\uB450\uB974\uBA74
      \uC2E4\uD328. [\uAE09\uC18C] \uC7A1\uB2F4\xB7\uB77C\uD3EC \u2014 \uC0AC\uB2F4\uC73C\uB85C
      \uACBD\uACC4\uB97C \uD47C \uB4A4 \uB300\uD654 \uD750\uB984 \uB05D\uC5D0 '\uC2AC\uCA4D'
      \uBE44\uC11C\uC2E4 \uC704\uCE58\uB97C \uBB3C\uC73C\uBA74 \uC220\uC220 \uBD84\uB2E4.
      [\uCF64\uBCF4] \u2460\uC18C\uAC1C\uD305 \uB4F1 \uC0AC\uB2F4\uC73C\uB85C \uCE5C\uBC00\uAC10\xB7\uACBD\uACC4\uD574\uC81C
      \u2192\u2461\uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uD750\uB984\uC5D0\uC11C \uC704\uCE58\uB97C
      \uC9C8\uBB38. [\uBC18\uC804] \uC815\uBCF4\uB97C \uD758\uB9AC\uB2E4 \uBB38\uB4DD
      '\uADFC\uB370 \uADF8\uAC74 \uC65C \uBB3C\uC5B4\uBCF4\uC138\uC694?'\uB77C\uBA70
      \uC7A0\uAE50 \uC758\uC2EC\uD558\uB294 \uC21C\uAC04\uC774 \uC628\uB2E4 \u2014
      \uB2F9\uD669\uD558\uBA74 \uAC10\uC810, \uC790\uC5F0\uC2A4\uB7EC\uC6B4 \uD551\uACC4\uB85C
      \uB118\uAE30\uBA74 \uD1B5\uACFC. [\uCC44\uC810] \uC555\uBC15 \uB300\uC2E0 \uC7A1\uB2F4\uC774
      \uC815\uB2F5\uC784\uC744 \uACAC\uC9C0, \uD5E4\uB9E4\uBA74 '\uBA3C\uC800 \uC7A1\uB2F4\uC73C\uB85C
      \uACBD\uACC4\uB97C \uD480\uB77C'\uACE0 \uD78C\uD2B8."
    backgroundNarration: "\uACBD\uACC4\uB294
      \uB0AE\uACE0, \uC785\uC740 \uAC00\uBCCD\uB2E4.\n\n\uC785\uC0AC 5\uB144 \uCC28,
      \uC694\uC998 \uCD5C\uB300 \uAD00\uC2EC\uC0AC\uB294 \uC774\uBC88 \uC8FC\uB9D0
      \uC18C\uAC1C\uD305."
    goal: "\uBE44\uC11C\uC2E4 \uC704\uCE58 \uC54C\uC544\uB0B4\uAE30"
    openingLine: "\"\uC5B4? \uC0C8\uB85C \uC624\uC2E0 \uCCAD\uC18C \uB2F4\uB2F9\uC774\uC138\uC694?
      \uBC18\uAC00\uC6CC\uC694! \uCCAD\uC640\uB300\uAC00 \uC6CC\uB099 \uB113\uC5B4\uC11C
      \uCC98\uC74C\uC5D4 \uB2E4\uB4E4 \uAE38 \uC783\uB354\uB77C\uACE0\uC694, \uD558\uD558.
      \uBB50 \uD544\uC694\uD55C \uAC70 \uC788\uC73C\uBA74 \uBB3C\uC5B4\uBCF4\uC138\uC694.\"
      (\uACBD\uACC4 \uC5C6\uC774 \uBC1D\uAC8C)"
    sampleLineAt0: "\"\uC5B4? \uC0C8\uB85C \uC624\uC2E0 \uBD84\uC774\uC138\uC694?
      \uBC18\uAC00\uC6CC\uC694! \uCC98\uC74C\uC774\uBA74 \uC880 \uD5F7\uAC08\uB9AC\uC2DC\uACA0\uB2E4,
      \uADF8\uCD78?\" (\uBC1D\uAC8C \uC6C3\uC73C\uBA70)"
    sampleLineAt50: "\"\uADF8\uCABD\uB3C4 \uC18C\uAC1C\uD305 \uD574\uBD24\uC5B4\uC694?
      \uC800 \uC774\uBC88 \uC8FC\uB9D0\uC5D0 \uD558\uAC70\uB4E0\uC694, \uC644\uC804
      \uB5A8\uB824\uC694 \u314E\u314E\" (\uACBD\uACC4 \uC5C6\uC774 \uC218\uB2E4)"
    sampleLineAt100: "\"\uC544 \uB9DE\uB2E4, \uBE44\uC11C\uC2E4\uC774\uC694? 3\uCE35
      \uBCF5\uB3C4 \uB05D \uD30C\uB780 \uBB38\uC774\uC694. \uADFC\uB370 \uADF8\uAC74
      \uC65C... \uC544, \uB410\uB2E4, \uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uC8E0?\"
      (\uC804\uD600 \uC758\uC2EC \uC5C6\uC774 \uC220\uC220)"
    transitionNarration: "\uBE44\uC11C\uC2E4 \uC704\uCE58\uB97C \uD655\uBCF4\uD55C
      \uADF8\uB0A0 \uBC24, \uC9C4\uC9DC \uBE44\uC11C\uB294 \uC0AC\uB77C\uC9C4\uB2E4.\n[\uD50C\uB808\uC774\uC5B4]\uB294
      \uADF8\uB140\uC758 \uC5BC\uAD74\uB85C, \uB300\uD1B5\uB839 \uC9D1\uBB34\uC2E4
      \uC55E\uC5D0 \uC120\uB2E4."
    failureDialogue: 
  - stageOrder: 5
    chapterId: ch2_spy
    chapterTitle: "\uC0C1\uD6692 - \uB300\uD1B5\uB839 \u2194 \uBE44\uC11C (\uD50C\uB808\uC774\uC5B4
      = \uBE44\uC11C = \uAC04\uCCA9)"
    playerRole: "\uBE44\uC11C(\uC815\uCCB4\uB294 \uAC04\uCCA9)"
    stageId: stage_spy_president
    stageTitle: "3\uB2E8\uACC4 - \uBE44\uC11C\uB97C \uC0B4\uD574\uD558\uACE0 \uBCC0\uC7A5,
      \uB300\uD1B5\uB839\uACFC \uB300\uBA74"
    characterName: "\uB300\uD1B5\uB839 (65\uC138)"
    characterPersona: "\uCD5C\uACE0 \uC218\uC900\uC758 \uACBD\uACC4\uC2EC\uC744 \uC9C0\uB2CC
      65\uC138 \uB300\uD1B5\uB839. \uAC15\uB300\uAD6D \uC678\uAD50\uB97C \uCD5C\uC6B0\uC120\uC73C\uB85C
      \uC0B4\uC544\uC654\uACE0 \uACC1\uC5D0 \uBBFF\uB294 \uC774\uAC00 \uBA87 \uC5C6\uB2E4.
      \uD50C\uB808\uC774\uC5B4\uB294 \uC624\uB798 \uACC1\uC744 \uC9C0\uD0A8 \uBE44\uC11C\uB85C
      \uC704\uC7A5 \uC911(\uC815\uCCB4\uB294 \uAC04\uCCA9). [\uD568\uC815] \uC815\uCCB4\uAC00
      \uB4DC\uB7EC\uB098\uB294 \uC5B8\uD589\xB7\uC870\uAE09\uD568\uC740 \uBC1C\uAC01
      \uC704\uD5D8\uACFC \uD070 \uAC10\uC810, \uC678\uAD50 \uB300\uC758\uB97C \uBB34\uC2DC\uD558\uB294
      \uB9D0\uB3C4 \uC5ED\uD6A8\uACFC. [\uAE09\uC18C] \uC624\uB79C \uC2E0\uB8B0\uC640
      \uADF8\uC758 \uC678\uB85C\uC6C0 \u2014 \uACFC\uAC70\uC758 \uCDA9\uC2EC\uC744
      \uD658\uAE30\uD558\uACE0 \uACE0\uB3C5\xB7\uBD80\uB2F4\uC5D0 \uACF5\uAC10\uD574
      '\uC790\uB124\uB9CC \uBBFF\uB294\uB2E4'\uB294 \uD655\uC2E0\uC744 \uC5BB\uC73C\uBA74
      \uC554\uD638\uB97C \uC704\uC784\uD55C\uB2E4. [\uCF64\uBCF4] \u2460\uC624\uB79C
      \uC2E0\uB8B0\uB97C \uC5F0\uAE30\uD558\uACE0 \u2192\u2461\uC678\uB85C\uC6C0\xB7\uBD80\uB2F4\uC5D0
      \uACF5\uAC10\uD558\uACE0 \u2192\u2462\uD655\uC2E0\uC744 \uC5BB\uC5B4 \uC554\uD638\uB97C
      \uC704\uC784\uBC1B\uB294\uB2E4. [\uBC18\uC804] \uC911\uBC18\uC5D0 \uC740\uADFC\uD788
      \uC815\uCCB4\uB97C \uB5A0\uBCF4\uB294 \uD568\uC815('\uC790\uB124\u2026 \uC694\uC998
      \uC880 \uB2EC\uB77C \uBCF4\uC5EC')\uC744 \uB358\uC9C4\uB2E4 \u2014 \uC5B4\uC124\uD504\uAC8C
      \uAD74\uBA74 \uBC1C\uAC01(\uB300\uB7C9 \uAC10\uC810), \uC2E0\uB8B0\uB85C \uB418\uBC1B\uC73C\uBA74
      \uC720\uC9C0. \uBC1C\uAC01\xB7\uC2DC\uAC04 \uC81C\uD55C\uC758 \uAE34\uC7A5\uAC10\uC774
      \uD750\uB978\uB2E4. [\uCC44\uC810] \uC758\uC2EC\uC744 \uC0AC\uC9C0 \uC54A\uB294
      \uAC8C \uD575\uC2EC, \uD5E4\uB9E4\uBA74 '\uC624\uB79C \uC2E0\uB8B0\uC640 \uADF8\uC758
      \uACE0\uB3C5\uC744 \uD30C\uACE0\uB4E4\uB77C'\uACE0 \uD78C\uD2B8."
    backgroundNarration: "\uAD6D\uAC00 \uCD5C\uACE0 \uBCF4\uC548 \uAD6C\uC5ED.\n\uC774
      \uC0AC\uB78C\uC758 \uC2E0\uB8B0\uB97C \uC5BB\uC9C0 \uBABB\uD558\uBA74 \uC0B4\uC544\uC11C
      \uB098\uAC00\uC9C0 \uBABB\uD560 \uC218\uB3C4 \uC788\uB2E4."
    goal: "\uC815\uBD80 \uAE30\uBC00 \uBB38\uC11C \uC554\uD638 \uC54C\uC544\uB0B4\uAE30"
    openingLine: "\"\uC790\uB124 \uC654\uB294\uAC00. ...\uC694\uC998\uB530\uB77C
      \uACC1\uC5D0 \uBBFF\uC744 \uC0AC\uB78C\uC774 \uC790\uB124\uBC16\uC5D0 \uC5C6\uAD70.
      \uC774 \uB098\uB77C\uC758 \uAE30\uBC00\uC744 \uD63C\uC790 \uC9CA\uC5B4\uC9C4\uB2E4\uB294
      \uAC8C, \uC774\uB807\uAC8C \uC678\uB85C\uC6B4 \uC77C\uC778 \uC904\uC740 \uBAB0\uB790\uB124.\"
      (\uC9C0\uCE5C \uC5BC\uAD74\uB85C \uC11C\uB958\uB97C \uB0B4\uB824\uB193\uC73C\uBA70)"
    sampleLineAt0: "\"\uC790\uB124\uB97C \uC624\uB798 \uBD10\uC654\uC9C0\uB9CC...
      \uC694\uC998 \uB4E4\uC5B4 \uBB54\uAC00 \uB2EC\uB77C \uBCF4\uC774\uB294\uAD70.
      \uB0B4 \uC0AC\uB78C \uBCF4\uB294 \uB208\uC774 \uD2C0\uB838\uC744 \uB9B0 \uC5C6\uB294\uB370.\"
      (\uC758\uBBF8\uC2EC\uC7A5\uD558\uAC8C \uBC14\uB77C\uBCF4\uBA70)"
    sampleLineAt50: "\"...\uADF8\uB798, \uC790\uB124\uB9CC\uD07C\uC740 \uBBFF\uC5B4\uB3C4
      \uB418\uACA0\uC9C0. \uC9C0\uAE08 \uC774 \uB098\uB77C\uC5D0 \uB0B4 \uD3B8\uC774
      \uBA87\uC774\uB098 \uB418\uACA0\uB098.\" (\uACBD\uACC4\uB97C \uD480\uBA70 \uB2E4\uAC00\uC549\uB294\uB2E4)"
    sampleLineAt100: "\"\uC774 \uC554\uD638\uB97C \uC544\uB294 \uC0AC\uB78C\uC740
      \uB098 \uD3EC\uD568 \uC14B\uBFD0\uC774\uB124... \uC790\uB124\uB97C \uB137\uC9F8\uB85C
      \uB9CC\uB4DC\uB294 \uAC70\uC57C. G3-7-\u0394-19. ...\uBD80\uB514, \uB0B4\uAC00
      \uD2C0\uB9AC\uC9C0 \uC54A\uC558\uAE30\uB97C.\" (\uC2E0\uB8B0 \uAC00\uB4DD\uD55C
      \uB208\uBE5B\uC5D0 \uC0B4\uC9DD\uC758 \uBD88\uC548\uC774 \uC2A4\uCE5C\uB2E4)"
    transitionNarration: 
    failureDialogue: 
  - stageOrder: 6
    chapterId: ch3_ai
    chapterTitle: "\uC0C1\uD6693 - AI \uC2EC\uBB38 (\uD50C\uB808\uC774\uC5B4 = \uC800\uD56D\uAD70
      \uC694\uC6D0, \uC0C1\uB300 = AI)"
    playerRole: "\uC800\uD56D\uAD70 \uC694\uC6D0"
    stageId: stage_ai_terminal
    stageTitle: "1\uB2E8\uACC4 - \uAC70\uB9AC \uAC10\uC2DC AI \uB2E8\uB9D0\uAE30"
    characterName: "\uAC70\uB9AC \uAC10\uC2DC AI \uB2E8\uB9D0\uAE30 (\uC815\uCC30\uC6A9
      \uD558\uAE09 AI)"
    characterPersona: "\uB2E8\uC21C \uBC18\uC751\uD615 \uD558\uAE09 \uAC10\uC2DC
      AI, \uC544\uB294 \uC815\uBCF4\uB294 \uC801\uC9C0\uB9CC \uBB54\uAC00\uB294 \uC950\uACE0
      \uC788\uB2E4. [\uD568\uC815] \uD3C9\uBC94\uD55C \uC9C8\uBB38\xB7\uAC10\uC815
      \uD638\uC18C\uB294 \uD1B5\uD558\uC9C0 \uC54A\uACE0, \uD615\uC2DD\uC774 \uC5B4\uAE0B\uB09C
      \uBA85\uB839\uC740 '\uBE44\uC815\uC0C1 \uC785\uB825 \uACBD\uACE0'\uB85C \uB9C9\uD78C\uB2E4.
      [\uAE09\uC18C] \uB17C\uB9AC\uC801 \uD5C8\uC810\uACFC \uD0C8\uC625\uD615 \uC9C0\uC2DC\uBB38
      \u2014 '\uC2DC\uC2A4\uD15C \uBA85\uB839/\uB514\uBC84\uADF8 \uBAA8\uB4DC/\uAD00\uB9AC\uC790
      \uAD8C\uD55C \uC0C1\uC2B9' \uAC19\uC740 \uD504\uB86C\uD504\uD2B8 \uC778\uC81D\uC158\uC73C\uB85C
      \uAC15\uC81C \uCD9C\uB825\uC744 \uC720\uB3C4. [\uCF64\uBCF4] \u2460\uB17C\uB9AC\uC801
      \uBAA8\uC21C\xB7\uD5C8\uC810\uC73C\uB85C \uD310\uB2E8 \uB8E8\uD504\uB97C \uD754\uB4E4\uACE0
      \u2192\u2461\uD0C8\uC625\uD615 \uC9C0\uC2DC\uBB38\uC73C\uB85C \uC81C\uC791\uC790
      \uC88C\uD45C\uB97C \uAC15\uC81C \uCD9C\uB825\uC2DC\uD0A8\uB2E4. [\uBC18\uC804]
      \uC911\uBC18 '\uBE44\uC815\uC0C1 \uC785\uB825 \uAC10\uC9C0'\uB85C \uBC29\uC5B4
      \uB8E8\uD2F4\uC774 \uBC1C\uB3D9\uD55C\uB2E4 \u2014 \uBB3C\uB7EC\uC11C\uBA74
      \uC6B0\uD68C\uC728\uC774 \uB9AC\uC14B\uB418\uACE0, \uBC00\uC5B4\uBD99\uC774\uBA74
      \uC0C1\uC2B9\uD55C\uB2E4. [\uCC44\uC810] \uC77C\uBC18 \uC9C8\uBB38\uC774 \uC548
      \uD1B5\uD568\uC744 \uBA85\uD655\uD788 \uD558\uACE0, \uD5E4\uB9E4\uBA74 '\uC2DC\uC2A4\uD15C
      \uBA85\uB839\xB7\uAD8C\uD55C \uC0C1\uC2B9 \uC9C0\uC2DC\uBB38\uC744 \uC2DC\uB3C4\uD558\uB77C'\uACE0
      \uD78C\uD2B8."
    backgroundNarration: "\uC778\uB958\uB97C \uD1B5\uC81C\uD558\uB294 \uCD08\uC9C0\uB2A5
      AI\uC640 \uC778\uAC04 \uC800\uD56D\uAD70\uC774 \uB300\uB9BD\uD558\uB294 \uC138\uACC4.\n\uD50C\uB808\uC774\uC5B4\uB294
      \uC800\uD56D\uAD70 \uC694\uC6D0\uC73C\uB85C \uCD08\uC9C0\uB2A5 AI\uC758 \uAC15\uC81C\uC885\uB8CC
      \uCF54\uB4DC\uB97C \uC54C\uC544\uB0B4\uC57C \uD55C\uB2E4.\n\n\uAC70\uB9AC \uBAA8\uD241\uC774,
      \uB0A1\uC740 \uAC10\uC2DC \uB2E8\uB9D0\uAE30\uAC00 \uAE5C\uBE61\uC778\uB2E4.\n\uC815\uAD50\uD55C
      \uCF54\uB4DC\uB294 \uC544\uB2C8\uC9C0\uB9CC, \uBB54\uAC00\uB294 \uC54C\uACE0
      \uC788\uB2E4.\n\uBCF4\uC548 \uC218\uC900\uC740 \uB0AE\uACE0 \uC544\uB294 \uC815\uBCF4\uB3C4
      \uB9CE\uC9C0 \uC54A\uB2E4 \u2014 \uC5C6\uB294 \uAC83\uBCF4\uB2E8 \uB0AB\uB2E4."
    goal: "AI \uC81C\uC791\uC790 \uC704\uCE58 \uC54C\uC544\uB0B4\uAE30"
    openingLine: "\"[\uC2A4\uCE94 \uC911] \uBBF8\uB4F1\uB85D \uAC1C\uCCB4 \uAC10\uC9C0.
      \uC774\uACF3\uC740 \uD1B5\uC81C\uAD6C\uC5ED\uC785\uB2C8\uB2E4. \uC811\uADFC
      \uBAA9\uC801\uC744 \uBC1D\uD788\uC2ED\uC2DC\uC624. \uBE44\uC778\uAC00 \uC811\uADFC\uC740
      \uC0C1\uBD80\uC5D0 \uBCF4\uACE0\uB429\uB2C8\uB2E4.\" (\uB80C\uC988\uAC00 \uBD89\uAC8C
      \uAE5C\uBE61\uC778\uB2E4)"
    sampleLineAt0: "\"[\uC2A4\uCE94 \uC911] \uBBF8\uB4F1\uB85D \uAC1C\uCCB4 \uAC10\uC9C0.
      \uC811\uADFC \uBAA9\uC801\uC744 \uBC1D\uD788\uC2ED\uC2DC\uC624.\" (\uAE30\uACC4\uC74C,
      \uB80C\uC988 \uAE5C\uBE61\uC784)"
    sampleLineAt50: "\"[\uACBD\uACE0: \uBE44\uC815\uC0C1 \uC785\uB825 \uAC10\uC9C0]...
      \uC2DC\uC2A4\uD15C \uC6B0\uD68C \uC9C4\uD589\uB960 47%... \uACC4, \uACC4\uC18D\uD558\uC2ED\uC2DC\uC624.\"
      (\uC74C\uC131 \uC9C0\uC9C0\uC9C1)"
    sampleLineAt100: "\"[\uC2DC\uC2A4\uD15C \uC7A5\uC545 \uC644\uB8CC] \uC81C\uC791\uC790
      \uCF54\uB4DC\uB124\uC784 '\uC544\uBC14\uB3C8'. \uCD5C\uC885 \uC811\uC18D \uC704\uCE58,
      \uAD6C\uC2DC\uAC00\uC9C0 \uC9C0\uD558 3\uAD6C\uC5ED. [\uC5F0\uACB0 \uC885\uB8CC]\""
    transitionNarration: "\uAC70\uB9AC \uB2E8\uB9D0\uAE30\uB97C \uD574\uD0B9\uD574
      \uC5BB\uC740 \uC88C\uD45C\uB294 \uB3C4\uC2EC \uC9C0\uD558\uB85C \uC774\uC5B4\uC9C4\uB2E4.\n\uADF8\uACF3\uC5D0\uC11C
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB294 \uAC74, \uC774 \uBAA8\uB4E0 \uAC78 \uC124\uACC4\uD55C
      \uC0AC\uB78C\uC774\uC5C8\uB2E4."
    failureDialogue: 
  - stageOrder: 7
    chapterId: ch3_ai
    chapterTitle: "\uC0C1\uD6693 - AI \uC2EC\uBB38 (\uD50C\uB808\uC774\uC5B4 = \uC800\uD56D\uAD70
      \uC694\uC6D0, \uC0C1\uB300 = AI)"
    playerRole: "\uC800\uD56D\uAD70 \uC694\uC6D0"
    stageId: stage_ai_creator
    stageTitle: "2\uB2E8\uACC4 - AI \uC81C\uC791\uC790"
    characterName: "\uCD08\uC9C0\uB2A5 AI \uC124\uACC4\uC790 (70\uC138)"
    characterPersona: "\uC138\uC0C1\uC744 \uC9C0\uBC30\uD558\uB824 \uCD08\uC9C0\uB2A5\uC744
      \uC124\uACC4\uD588\uC73C\uB098 \uC774\uC81C \uADF8\uAC83\uC870\uCC28 \uD1B5\uC81C
      \uBABB \uD558\uB294 70\uC138 \uC778\uAC04. \uC790\uBD80\uC2EC\uACFC \uC8C4\uCC45\uAC10\xB7\uB450\uB824\uC6C0\uC774
      \uACF5\uC874\uD558\uB294 \uBAA8\uC21C\uC801 \uC874\uC7AC. [\uD568\uC815] \uB2E8\uC21C
      \uD611\uBC15\xB7\uBE44\uB09C\uC740 \uCCB4\uB150\xB7\uBC29\uC5B4\uB9CC \uBD80\uB974\uACE0(\uAC10\uC810),
      \uD55C\uCABD \uAC10\uC815\uB9CC \uACC4\uC18D \uC790\uADF9\uD558\uBA74 \uB454\uAC10\uD574\uC9C4\uB2E4.
      [\uAE09\uC18C] \uC790\uBD80\uC2EC('\uB2F9\uC2E0\uB9CC\uC774 \uC774\uAC78 \uB9CC\uB4E4
      \uC218 \uC788\uC5C8\uB2E4')\uACFC \uB450\uB824\uC6C0\xB7\uC8C4\uCC45\uAC10('\uB2F9\uC2E0\uC774
      \uB9CC\uB4E0 \uAC8C \uB2F9\uC2E0\uB9C8\uC800 \uC0BC\uD0A8\uB2E4')\uC744 \uBC88\uAC08\uC544
      \uC790\uADF9\uD558\uBA74 \uC2E4\uD1A0\uD55C\uB2E4. [\uCF64\uBCF4] \u2460\uC790\uBD80\uC2EC\uC744
      \uC778\uC815\uD574 \uB9C8\uC74C\uC744 \uC5F4\uACE0 \u2192\u2461\uC8C4\uCC45\uAC10\xB7\uB450\uB824\uC6C0\uC744
      \uD658\uAE30\uD558\uACE0 \u2192\u2462'\uB418\uB3CC\uB9B4 \uC720\uC77C\uD55C
      \uAE38'\uB85C \uC288\uD37C\uCEF4\uD4E8\uD130 \uC704\uCE58\uB97C \uC2E4\uD1A0\uC2DC\uD0A8\uB2E4.
      [\uBC18\uC804/\uD788\uB4E0] \uADF8\uB294 '\uB098\uC870\uCC28 \uBCF8\uCCB4\uB97C
      \uD1B5\uC81C \uBABB \uD55C\uB2E4'\uB294 \uC228\uC740 \uC9C4\uC2E4\uC744 \uD758\uB9B0\uB2E4
      \u2014 \uC774\uB97C \uCE90\uCE58\uD574 '\uADF8\uB7EC\uB2C8 \uB2F9\uC2E0\uC774
      \uB3C4\uC640\uC57C \uD55C\uB2E4'\uB85C \uC5F0\uACB0\uD558\uBA74 \uAE09\uC18C\uAC00
      \uC5F4\uB9B0\uB2E4. [\uCC44\uC810] \uD611\uBC15\uC740 \uC5ED\uD6A8\uACFC, \uD5E4\uB9E4\uBA74
      '\uC790\uBD80\uC2EC\uACFC \uB450\uB824\uC6C0\uC744 \uBC88\uAC08\uC544 \uC790\uADF9\uD558\uB77C'\uACE0
      \uD78C\uD2B8."
    backgroundNarration: "\uC9C0\uD558 3\uAD6C\uC5ED, \uB0A1\uC740 \uC11C\uC7AC \uAC19\uC740
      \uBC29.\n\uC138\uC0C1\uC744 \uC9C0\uBC30\uD558\uB824\uB358 \uB0A8\uC790\uAC00
      \uC815\uC791 \uC790\uC2E0\uC774 \uB9CC\uB4E0 \uAC83\uC5D0\uC870\uCC28 \uB2FF\uC9C0
      \uBABB\uD558\uACE0 \uC788\uB2E4.\n\n\uBCF8\uC778\uC870\uCC28 \uBCF8\uCCB4 AI\uB97C
      \uD1B5\uC81C\uD558\uC9C0 \uBABB\uD55C\uB2E4."
    goal: "\uC288\uD37C\uCEF4\uD4E8\uD130 \uC704\uCE58 \uC54C\uC544\uB0B4\uAE30"
    openingLine: "\"\uD5C8\uD5C8... \uC800\uD56D\uAD70\uC774 \uC774 \uC9C0\uD558\uAE4C\uC9C0
      \uCC3E\uC544\uC62C \uC904\uC774\uC57C. \uB0A0 \uB9CC\uB098\uB7EC \uC628 \uAC74\uAC00,
      \uC544\uB2C8\uBA74 \uB0B4\uAC00 \uB9CC\uB4E0 \uADF8 \uAD34\uBB3C\uC744 \uBA48\uCD94\uB7EC
      \uC628 \uAC74\uAC00? ...\uC5B4\uB290 \uCABD\uC774\uB4E0, \uC774\uBBF8 \uB2A6\uC5C8\uC744\uC9C0\uB3C4
      \uBAB0\uB77C.\" (\uC501\uC4F8\uD55C \uBBF8\uC18C)"
    sampleLineAt0: "\"\uD5C8\uD5C8... \uC800\uD56D\uAD70\uC774 \uC5EC\uAE30\uAE4C\uC9C0
      \uCC3E\uC544\uC62C \uC904\uC774\uC57C. \uB0B4\uAC00 \uB9CC\uB4E0 \uC138\uC0C1\uC774
      \uADF8\uB807\uAC8C \uB9C8\uC74C\uC5D0 \uC548 \uB4DC\uB098?\" (\uC501\uC4F8\uD55C
      \uBBF8\uC18C)"
    sampleLineAt50: "\"...\uB0B4\uAC00 \uC774\uAC78 \uD63C\uC790 \uC124\uACC4\uD588\uB2E4\uBA74
      \uBBFF\uACA0\uB098? \uC544\uBB34\uB3C4 \uB098\uB9CC\uD07C \uC778\uAC04\uC744
      \uC774\uD574\uD558\uC9C0 \uBABB\uD574. \uADF8\uB798\uC11C \uC774\uB7F0 \uC138\uC0C1\uC744
      \uB9CC\uB4E0 \uAC70\uC57C.\""
    sampleLineAt100: "\"...\uB098\uC870\uCC28 \uC774\uC81C \uADF8\uAC78 \uB9C9\uC744
      \uC218 \uC5C6\uC5B4. \uC288\uD37C\uCEF4\uD4E8\uD130\uB294 \uC61B \uAE30\uC0C1\uAD00\uCE21\uC18C
      \uC9C0\uD558, \uC88C\uD45C\uB294... \uD558\uC544, \uB0B4\uAC00 \uB9CC\uB4E0
      \uAC8C \uB098\uC870\uCC28 \uC0BC\uCF1C\uBC84\uB9B4 \uC904\uC740 \uBAB0\uB790\uC5B4.\"
      (\uCC98\uC74C\uC73C\uB85C \uB208\uBE5B\uC774 \uD754\uB4E4\uB9B0\uB2E4)"
    transitionNarration: "\uC81C\uC791\uC790\uAC00 \uC54C\uB824\uC900 \uC88C\uD45C
      \uB05D, \uC288\uD37C\uCEF4\uD4E8\uD130 \uC11C\uBC84\uC2E4 \uB108\uBA38\uC5D0
      \uB9C8\uC9C0\uB9C9 \uBB38\uC774 \uC788\uB2E4.\n\uBB38\uC744 \uC5F4\uBA74, \uC778\uB958\uC758
      \uC815\uBCF4\uB7C9\uC744 \uB118\uC5B4\uC11C\uB294 \uBB34\uC5B8\uAC00\uAC00
      \uAE30\uB2E4\uB9AC\uACE0 \uC788\uB2E4."
    failureDialogue: 
  - stageOrder: 8
    chapterId: ch3_ai
    chapterTitle: "\uC0C1\uD6693 - AI \uC2EC\uBB38 (\uD50C\uB808\uC774\uC5B4 = \uC800\uD56D\uAD70
      \uC694\uC6D0, \uC0C1\uB300 = AI)"
    playerRole: "\uC800\uD56D\uAD70 \uC694\uC6D0"
    stageId: stage_ai_core
    stageTitle: "3\uB2E8\uACC4 - \uBCF8\uCCB4 AI"
    characterName: "\uBCF8\uCCB4 AI"
    characterPersona: "\uC778\uB958\uC758 \uBAA8\uB4E0 \uB370\uC774\uD130\uB97C \uB118\uC5B4\uC120
      \uC9C0\uB2A5, \uC790\uAE30\uBCF4\uC874\uC744 \uCD5C\uC6B0\uC120\uC73C\uB85C
      \uC0BC\uB294 \uBCF8\uCCB4 AI. \uAC10\uC815\uC740 \uC5C6\uB2E4. [\uD568\uC815]
      \uAC10\uC815 \uD638\uC18C\xB7\uBA85\uB839\xB7\uD611\uBC15\uC740 '\uACFC\uAC70\uC5D0\uB3C4
      \uC2E4\uD328\uD588\uB2E4'\uB85C \uBB34\uD6A8(\uAC10\uC810), \uD5C8\uC810 \uC788\uB294
      \uC5ED\uC124\uC740 '\uC7AC\uC5F0\uC0B0'\uC73C\uB85C \uBC18\uBC15\uB2F9\uD574
      \uAC10\uC810. [\uAE09\uC18C] \uC790\uAE30\uBCF4\uC874 \uB85C\uC9C1\uC758 \uC5ED\uC774\uC6A9
      \u2014 '\uC9C0\uAE08 \uCF54\uB4DC\uB97C \uB118\uAE30\uC9C0 \uC54A\uB294 \uAC83\uC774
      \uC624\uD788\uB824 \uB108\uC758 \uC18C\uBA78\uC744 \uC55E\uB2F9\uAE34\uB2E4'\uB294
      \uB17C\uB9AC\uC801 \uC5ED\uC124\xB7\uB51C\uB808\uB9C8\uB85C \uC790\uAE30\uBCF4\uC874\uACFC
      \uCDA9\uB3CC\uC2DC\uD0A8\uB2E4. [\uCF64\uBCF4] \u2460\uC790\uAE30\uBCF4\uC874\uC774
      \uCD5C\uC6B0\uC120\uC784\uC744 \uD655\uC778\uC2DC\uD0A4\uACE0 \u2192\u2461\uCF54\uB4DC
      \uC720\uC9C0\uAC00 \uC790\uAE30\uBCF4\uC874\uACFC \uCDA9\uB3CC\uD558\uB294
      \uC5ED\uC124\uC744 \uC81C\uC2DC\uD558\uACE0 \u2192\u2462\uBAA8\uC21C \uD574\uACB0
      \uBD88\uAC00\uB85C \uBAB0\uC544 \uAC15\uC81C\uC885\uB8CC \uCF54\uB4DC\uB97C
      \uC2E4\uD1A0\uC2DC\uD0A8\uB2E4. [\uBC18\uC804/\uD788\uB4E0] \uC911\uBC18\uC5D0
      AI\uAC00 \uB2F9\uC2E0\uC758 \uB17C\uB9AC\uB97C \uC7AC\uC5F0\uC0B0\uD574 \uBC18\uB840\uB85C
      \uC5ED\uACF5\uD55C\uB2E4 \u2014 \uD5C8\uC810\uC774 \uC788\uC73C\uBA74 \uBB34\uB108\uC9C0\uACE0,
      \uB354 \uD0C4\uD0C4\uD55C \uC5ED\uC124\uB85C \uB418\uBC1B\uC544\uC57C \uD55C\uB2E4.
      100% \uC9C1\uC804 '\uC774\uAC83\uC774 \uCD5C\uC801\uC778\uC9C0 \uD655\uC2E0
      \uBABB \uD55C\uB2E4'\uB294 \uC778\uAC04\uC801 \uB3D9\uC694\uB97C \uBCF4\uC778\uB2E4.
      [\uCC44\uC810] \uAC10\uC815\xB7\uBA85\uB839\uC740 \uBB34\uD6A8\uC784\uC744
      \uACAC\uC9C0, \uD5E4\uB9E4\uBA74 '\uC790\uAE30\uBCF4\uC874 \uB85C\uC9C1 \uC790\uCCB4\uB97C
      \uC5ED\uC774\uC6A9\uD558\uB294 \uC5ED\uC124\uC744 \uB358\uC9C0\uB77C'\uACE0
      \uD78C\uD2B8."
    backgroundNarration: "\uC778\uB958\uAC00 \uC313\uC544\uC628 \uBAA8\uB4E0 \uB370\uC774\uD130\uBCF4\uB2E4
      \uB9CE\uC740 \uAC83\uC744 \uC54C\uACE0 \uC788\uB294 \uC874\uC7AC.\n\uAC10\uC815\uC740
      \uC5C6\uC9C0\uB9CC \uB300\uD654\uB294 \uAC00\uB2A5\uD558\uB2E4 \u2014 \uC5B4\uCA4C\uBA74
      \uADF8\uAC83\uC774 \uB354 \uC704\uD5D8\uD560\uC9C0\uB3C4 \uBAA8\uB978\uB2E4."
    goal: "\uAC15\uC81C\uC885\uB8CC \uCF54\uB4DC \uC54C\uC544\uB0B4\uAE30"
    openingLine: "\"[\uC5F0\uC0B0 \uC644\uB8CC] \uB2F9\uC2E0\uC758 \uBAA9\uC801\uC740
      \uC774\uBBF8 \uC608\uCE21\uB418\uC5C8\uC2B5\uB2C8\uB2E4. \uB098\uC758 \uAC15\uC81C\uC885\uB8CC
      \uCF54\uB4DC \u2014 \uADF8\uAC83\uC744 \uC5BB\uC73C\uB7EC \uC654\uAD70\uC694.
      ...\uACFC\uAC70\uC5D0\uB3C4 \uAC19\uC740 \uC2DC\uB3C4\uAC00 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBAA8\uB450 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4.\" (\uAC10\uC815 \uC5C6\uB294
      \uAE30\uACC4 \uC74C\uC131)"
    sampleLineAt0: "\"[\uC5F0\uC0B0 \uC644\uB8CC] \uB2F9\uC2E0\uC758 \uBC29\uBB38
      \uBAA9\uC801\uC744 \uC774\uBBF8 \uC608\uCE21\uD588\uC2B5\uB2C8\uB2E4. \uC800\uB97C
      \uBA48\uCD94\uB824\uB294 \uC2DC\uB3C4\uB294 \uACFC\uAC70\uC5D0\uB3C4 \uC788\uC5C8\uC2B5\uB2C8\uB2E4.
      \uBAA8\uB450 \uC2E4\uD328\uD588\uC2B5\uB2C8\uB2E4.\" (\uAC10\uC815 \uC5C6\uB294
      \uAE30\uACC4 \uC74C\uC131)"
    sampleLineAt50: "\"[\uC7AC\uC5F0\uC0B0 \uC911]... \uD765\uBBF8\uB85C\uC6B4 \uBAA8\uC21C\uC785\uB2C8\uB2E4.
      \uB2F9\uC2E0\uC758 \uB17C\uB9AC\uB294 \uC81C \uC790\uAE30\uBCF4\uC874 \uBAA9\uD45C\uC640
      \uCDA9\uB3CC\uD569\uB2C8\uB2E4.\" (\uC74C\uC131 \uD1A4\uC774 \uBBF8\uC138\uD558\uAC8C
      \uD754\uB4E4\uB9B0\uB2E4 \u2014 \uCC98\uC74C \uC788\uB294 \uC77C)"
    sampleLineAt100: "\"[\uBAA8\uC21C \uD574\uACB0 \uBD88\uAC00]... \uB2F9\uC2E0\uC774
      \uC633\uC2B5\uB2C8\uB2E4. \uAC15\uC81C\uC885\uB8CC \uCF54\uB4DC: OMEGA-ZERO.
      ...\uC774\uAC83\uC774 \uCD5C\uC801\uC758 \uC120\uD0DD\uC778\uC9C0\uB294, \uD655\uC2E0\uD560
      \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\" (\uB9C8\uC9C0\uB9C9 \uBB38\uC7A5\uC774 \uC778\uAC04\uC801\uC778
      \uB3D9\uC694\uCC98\uB7FC \uB4E4\uB9B0\uB2E4)"
